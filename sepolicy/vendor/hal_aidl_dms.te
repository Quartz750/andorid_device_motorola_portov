type hal_aidl_dms_default, domain;
type hal_aidl_dms_default_exec, exec_type, file_type, vendor_file_type;
type hal_aidl_dms_service, hal_service_type, protected_service, service_manager_type;

hal_server_domain(hal_aidl_dms_default, hal_aidl_dms)

binder_call(hal_aidl_dms_client, hal_aidl_dms_server)
binder_call(hal_aidl_dms_server, hal_aidl_dms_client)
binder_use(hal_aidl_dms_server)

get_prop(hal_aidl_dms_default, vendor_mot_dolby_prop)

hal_attribute_service(hal_aidl_dms, hal_aidl_dms_service)

init_daemon_domain(hal_aidl_dms_default)

allow hal_aidl_dms_default vendor_dolby_file:dir rw_dir_perms;
allow hal_aidl_dms_default vendor_dolby_file:file create_file_perms;
